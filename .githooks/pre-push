#!/bin/sh
# Block push if unit tests fail. Confluence is mocked; no network needed.
set -e
cd "$(git rev-parse --show-toplevel)"
if ! command -v go >/dev/null 2>&1; then
	echo "pre-push: go nicht gefunden — Tests können nicht laufen" >&2
	exit 1
fi
echo "pre-push: go test -race ./..." >&2
go test -race ./...
