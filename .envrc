# Nur Hinweis beim cd. Kein Build, kein Install, keine Secrets.

bold="$(printf '\033[1m')"
dim="$(printf '\033[2m')"
cyan="$(printf '\033[36m')"
green="$(printf '\033[32m')"
yellow="$(printf '\033[33m')"
magenta="$(printf '\033[35m')"
reset="$(printf '\033[0m')"

ver="$(git describe --tags --always --dirty 2>/dev/null || tr -d '[:space:]' < VERSION 2>/dev/null || echo dev)"

printf '\n'
printf '  %s📦  md2c%s  %s%s%s  %s·  optimized by Danny Neumann%s\n' \
	"$bold$cyan" "$reset" "$bold" "$ver" "$reset" "$dim" "$reset"
printf '  %s──────────────────────────────────────────────%s\n' "$dim" "$reset"
printf '\n'
printf '  %s🔧  Einmal einrichten%s\n' "$bold" "$reset"
printf '     %s1.%s  Config anlegen (Zugang, nicht committen):\n' "$yellow" "$reset"
printf '        %smkdir -p ~/.config/md2c%s\n' "$green" "$reset"
printf '        %scp md2c.conf.example ~/.config/md2c/md2c.conf%s\n' "$green" "$reset"
printf '        %s# MD2C_BASE_URL, MD2C_USER, MD2C_TOKEN eintragen%s\n' "$dim" "$reset"
printf '\n'
printf '     %s2.%s  Binary bauen und nach ~/.local/bin legen:\n' "$yellow" "$reset"
printf '        %smake install%s\n' "$green" "$reset"
printf '        %s→  ~/.local/bin/md2c%s  (PATH: ~/.local/bin)\n' "$dim" "$reset"
printf '\n'
printf '  %s🚀  Danach publizieren%s\n' "$bold" "$reset"
printf '     Mit Ziel im Dateikopf  %s<!-- space:PSE,path:…,title:… -->%s\n' "$magenta" "$reset"
printf '        %smd2c docs/stagingkonzept.md%s\n' "$green" "$reset"
printf '\n'
printf '     Ohne Dateikopf Space und Pfad mitgeben:\n'
printf '        %smd2c docs/stagingkonzept.md PSE "Decisions+Konzepte/Draft: Stagingkonzept"%s\n' "$green" "$reset"
printf '\n'
printf '  %s🔐  Zugang%s  nur aus  %s~/.config/md2c/md2c.conf%s\n' "$bold" "$reset" "$cyan" "$reset"
printf '     %sKeine Shell-Env, keine Flags, nichts im Binary. Datei fehlt → Fehler.%s\n' "$dim" "$reset"
printf '\n'
